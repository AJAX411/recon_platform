# ==========================================
# Proyecto Recon Facial - Backend
# Plantilla de configuración local
# ==========================================

# Base de desarrollo
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Base y credenciales exclusivas de pruebas
DB_TEST_NAME=
DB_TEST_USER=
DB_TEST_PASSWORD=

# Seguridad
# Generar un valor aleatorio de al menos 32 bytes UTF-8; nunca versionar el real.
SECRET_KEY=

# Por defecto las cookies de sesión exigen HTTPS (producción).
# Exclusivamente en HTTP local, con Flask limitado a 127.0.0.1:
# RECON_LOCAL_HTTP=1
# RECON_SESSION_COOKIE_SECURE=0
